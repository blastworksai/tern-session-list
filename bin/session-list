#!/bin/sh
# session-list: this Tern tab's session list, as a command.
# POSIX sh. Talks to the session-list plugin's host half through request files,
# exactly as THE REQUEST PROTOCOL in plans/tern-session-list-plugin.md fixes it:
# D/pedidos/N.req (written as .tmp, then mv) -> D/respostas/N.res + N.done.

# These two texts MUST match lib/textos.luau (English: semResposta, ajuda).
SEM_RESPOSTA='Tern'"'"'s session-list plugin did not answer: is Tern running with the plugin loaded? Run `tern plugin list`.'
AJUDA='session-list: this Tern tab'"'"'s session list (the parts of the work agreed with the person that are still open).

  session-list add "<text>"...      add items, one per argument
      --subject <s>                 also name the list
      --again                       re-add a text the person removed by hand
  session-list doing <id>           mark the item you are working on (one at a time)
  session-list done <id>...         tick items as done
  session-list undo <id>...         untick done items
  session-list remove <id>...       remove items
  session-list name <subject>       name the list
  session-list block <id> <reason>  mark an item as waiting on someone
  session-list unblock <id>         back to open
  session-list show                 show this tab'"'"'s list and lists closed tabs left
  session-list adopt <listId>       take over a list a closed tab left
  session-list discard <listId>     discard a list a closed tab left
  session-list start                session-start hook: the list and orphan questions
  session-list check                stop hook: reminds of open items
      --hook                        read the hook'"'"'s JSON on stdin, exit 2 to remind
  session-list help                 this screen

Every answer is the list as it now stands.'

NL='
'

# A value goes on one line: every newline becomes a space.
umalinha() {
	printf '%s' "$1" | tr '\n' ' '
}

case "${1-}" in
'' | help | -h | --help)
	printf '%s\n' "$AJUDA"
	exit 0
	;;
esac

if [ -z "${TERN_PANE-}" ]; then
	printf '%s\n' "session-list only works inside a Tern pane." >&2
	exit 1
fi

# Where the plugin's data folder is.
if [ -n "${SESSION_LIST_DATA-}" ]; then
	D=$SESSION_LIST_DATA
elif [ -n "${TERN_CONFIG_DIR-}" ]; then
	D=$TERN_CONFIG_DIR/plugin-data/session-list
elif [ "$(uname -s)" = Darwin ]; then
	D=$HOME/Library/"Application Support"/Tern/plugin-data/session-list
else
	# Linux: unverified (Tern's folder there was never measured).
	D=${XDG_CONFIG_HOME:-$HOME/.config}/tern/plugin-data/session-list
fi

verb=''
args=''
subject=''
again=''
hook=''
while [ $# -gt 0 ]; do
	case "$1" in
	--subject)
		if [ $# -lt 2 ]; then
			printf '%s\n' "session-list: --subject needs a value." >&2
			exit 1
		fi
		subject=$(umalinha "$2")
		shift 2
		continue
		;;
	--again) again=1 ;;
	--hook) hook=1 ;;
	*)
		if [ -z "$verb" ]; then
			verb=$(umalinha "$1")
		else
			args="${args}arg=$(umalinha "$1")$NL"
		fi
		;;
	esac
	shift
done

if [ -z "$verb" ]; then
	printf '%s\n' "$AJUDA"
	exit 0
fi

# --hook only means something for check; only then is stdin read.
if [ "$verb" != check ]; then
	hook=''
fi
stopinput=''
if [ -n "$hook" ]; then
	stopinput=$(awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }')
fi

N="$(date +%s)-$$-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
mkdir -p "$D/pedidos" "$D/respostas" || exit 1
req=$D/pedidos/$N.req
res=$D/respostas/$N.res
done_=$D/respostas/$N.done

{
	printf 'v=1\n'
	printf 'pane=%s\n' "$(umalinha "$TERN_PANE")"
	printf 'verb=%s\n' "$verb"
	printf '%s' "$args"
	if [ -n "$subject" ]; then printf 'subject=%s\n' "$subject"; fi
	if [ -n "$again" ]; then printf 'again=1\n'; fi
	if [ -n "${SESSION_LIST_NO_ORPHANS-}" ]; then printf 'noorphans=1\n'; fi
	if [ -n "$hook" ]; then printf 'stopinput=%s\n' "$stopinput"; fi
	printf 'end=1\n'
} >"$req.tmp" || exit 1
mv "$req.tmp" "$req" || exit 1

# Poll for the answer: every 0.1 s up to 5 s, or 1 s steps where sleep 0.1 fails.
if sleep 0.1 2>/dev/null; then
	passo=0.1
	vezes=50
else
	passo=1
	vezes=5
fi
i=0
while [ ! -f "$done_" ]; do
	if [ "$i" -ge "$vezes" ]; then
		printf '%s\n' "$SEM_RESPOSTA" >&2
		rm -f "$req"
		exit 1
	fi
	sleep "$passo"
	i=$((i + 1))
done

status=$(head -n 1 "$res" 2>/dev/null)
texto=$(tail -n +2 "$res" 2>/dev/null)
rm -f "$res" "$done_"

case "$status" in
status=ok)
	printf '%s\n' "$texto"
	exit 0
	;;
status=remind)
	if [ -n "$hook" ]; then
		printf '%s\n' "$texto" >&2
		exit 2
	fi
	printf '%s\n' "$texto"
	exit 0
	;;
*)
	printf '%s\n' "$texto" >&2
	exit 1
	;;
esac
